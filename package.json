{
  "name": "bos-lightbox",
  "version": "0.1.0",
  "description": "Framework-agnostic document preview lightbox web component. Supports images, PDFs, and other file types with keyboard navigation.",
  "type": "module",
  "main": "dist/document-preview.js",
  "module": "dist/document-preview.js",
  "browser": "dist/document-preview.js",
  "unpkg": "dist/document-preview.js",
  "jsdelivr": "dist/document-preview.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/document-preview.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc",
    "preview": "vite preview",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "test:coverage": "web-test-runner --coverage"
  },
  "keywords": [
    "web-component",
    "lightbox",
    "document-preview",
    "lit",
    "pdf-preview",
    "image-lightbox",
    "gallery",
    "modal",
    "overlay",
    "custom-element",
    "wc",
    "react",
    "react-component",
    "typescript"
  ],
  "license": "MIT",
  "author": {
    "name": "Prabin Paudel",
    "email": "prabin.paudel60@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/prabin194/bos-lightbox.git"
  },
  "bugs": {
    "url": "https://github.com/prabin194/bos-lightbox/issues"
  },
  "homepage": "https://github.com/prabin194/bos-lightbox#readme",
  "dependencies": {
    "lit": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@web/test-runner": "^0.18.0",
    "@web/test-runner-playwright": "^0.11.0",
    "@web/test-runner-mocha": "^0.8.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "lit": "^3.2.0"
  }
}
