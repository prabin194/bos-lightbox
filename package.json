{
  "name": "bos-lightbox",
  "version": "0.1.0",
  "type": "module",
  "description": "React-based lightbox component for previewing images, PDFs, and other documents with keyboard navigation, zoom, and touch support.",
  "license": "MIT",
  "author": "Prabin Paudel",
  "repository": {
    "type": "git",
    "url": "https://github.com/prabin194/bos-lightbox.git"
  },
  "homepage": "https://github.com/prabin194/bos-lightbox",
  "bugs": {
    "url": "https://github.com/prabin194/bos-lightbox/issues"
  },
  "main": "./dist/bos-lightbox.umd.cjs",
  "module": "./dist/bos-lightbox.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bos-lightbox.js",
      "require": "./dist/bos-lightbox.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "lightbox",
    "image-viewer",
    "document-preview",
    "react",
    "gallery",
    "modal",
    "pdf-viewer",
    "component"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  }
}
